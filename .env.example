# ---------------------------------------------------------------------------
# AI Support Platform - frontend configuration
#
#   cp .env.example .env
#
# Vite only exposes variables prefixed VITE_, and it inlines them at build time,
# so treat every value here as public. Never put a secret in this file.
# ---------------------------------------------------------------------------

# Backend API root. Must include the /api/v1 path segment.
VITE_API_URL=http://localhost:4001/api/v1

# Socket.IO origin - the server root, without the API path.
VITE_SOCKET_URL=http://localhost:4001

VITE_APP_NAME=AI Support Platform
